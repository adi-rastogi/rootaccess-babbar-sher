# ============================================================
# POLLUTIONMITRA — Environment Variables Configuration
# Copy to .env and fill in configuration values
# ============================================================

# App Configuration
NODE_ENV=development
VITE_API_URL=http://localhost:8000
VITE_ENABLE_DEMO_MODE=true

# Backend Server
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL + PostGIS Database
POSTGRES_USER=pollutionmitra
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=pollutionmitra_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pollutionmitra:change_this_secure_password@localhost:5432/pollutionmitra_db

# JWT Security
SECRET_KEY=change_this_jwt_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External APIs & Live Telemetry
WEATHER_API_KEY=your_weatherapi_or_openweather_key_here
ROUTING_PROVIDER_URL=http://router.project-osrm.org
AI_PROVIDER_API_KEY=your_llm_api_key_here
VITE_WAQI_TOKEN=your_waqi_api_token_here
VITE_OPENAQ_API_KEY=your_openaq_v3_api_key_here

# MQTT Broker (for Physical IoT Sensors)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=pollutionmitra/sensors

